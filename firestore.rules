rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function self(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validPublicProfile(uid, data) {
      return data.keys().hasOnly(['uid', 'displayName', 'avatarColor', 'updatedAt'])
        && data.uid == uid
        && data.displayName is string
        && data.displayName.size() >= 2
        && data.displayName.size() <= 60
        && data.avatarColor is int
        && data.updatedAt is int;
    }

    match /users/{uid} {
      allow get: if self(uid);
      allow list: if false;
      allow create, update: if self(uid)
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'displayName', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 60
        && request.resource.data.createdAt is int
        && request.resource.data.updatedAt is int;
      allow delete: if false;
    }

    // This collection contains only the fields intentionally exposed for account discovery.
    // Email addresses and other private profile data must never be stored here.
    match /publicProfiles/{uid} {
      allow get, list: if signedIn();
      allow create: if self(uid) && validPublicProfile(uid, request.resource.data);
      allow update: if self(uid)
        && validPublicProfile(uid, request.resource.data);
      allow delete: if false;
    }

    match /channels/{channelId} {
      allow get, list: if signedIn()
        && (resource.data.isPublic == true || request.auth.uid in resource.data.members);

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'name', 'description', 'iconName', 'kind', 'isPublic', 'members',
          'memberNames', 'createdBy', 'createdAt', 'lastMessage', 'lastMessageTime'
        ])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 80
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 300
        && request.resource.data.members is list
        && request.auth.uid in request.resource.data.members
        && request.resource.data.memberNames is map
        && request.resource.data.createdAt is int
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessageTime is int
        && (
          (
            request.resource.data.kind == 'channel'
            && request.resource.data.isPublic == true
            && request.resource.data.members.size() == 1
            && request.resource.data.members[0] == request.auth.uid
          )
          ||
          (
            request.resource.data.kind == 'dm'
            && request.resource.data.isPublic == false
            && request.resource.data.members.size() == 2
            && request.resource.data.members[0] != request.resource.data.members[1]
            && exists(/databases/$(database)/documents/publicProfiles/$(request.resource.data.members[0]))
            && exists(/databases/$(database)/documents/publicProfiles/$(request.resource.data.members[1]))
          )
        );

      allow update: if signedIn() && (
        (
          request.auth.uid in resource.data.members
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['lastMessage', 'lastMessageTime'])
          && request.resource.data.lastMessage is string
          && request.resource.data.lastMessage.size() <= 4000
          && request.resource.data.lastMessageTime is int
        )
        ||
        (
          resource.data.isPublic == true
          && !(request.auth.uid in resource.data.members)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && request.auth.uid in request.resource.data.members
          && request.resource.data.members.hasAll(resource.data.members)
          && request.resource.data.members.size() == resource.data.members.size() + 1
        )
      );

      allow delete: if signedIn() && resource.data.createdBy == request.auth.uid;

      match /messages/{messageId} {
        function isConversationMember() {
          return signedIn()
            && request.auth.uid in get(
              /databases/$(database)/documents/channels/$(channelId)
            ).data.members;
        }

        allow get, list: if isConversationMember();

        allow create: if isConversationMember()
          && request.resource.data.keys().hasOnly([
            'senderId', 'senderName', 'senderAvatarColor', 'content',
            'timestamp', 'status', 'replyToId', 'replyToSnippet', 'reaction'
          ])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.senderName is string
          && request.resource.data.senderName.size() <= 60
          && request.resource.data.senderAvatarColor is int
          && request.resource.data.content is string
          && request.resource.data.content.size() >= 1
          && request.resource.data.content.size() <= 4000
          && request.resource.data.timestamp is int
          && request.resource.data.status == 'sent'
          && (
            request.resource.data.replyToId == null
            || request.resource.data.replyToId is string
          )
          && (
            request.resource.data.replyToSnippet == null
            || (request.resource.data.replyToSnippet is string
              && request.resource.data.replyToSnippet.size() <= 80)
          )
          && (
            request.resource.data.reaction == null
            || (request.resource.data.reaction is string
              && request.resource.data.reaction.size() <= 16)
          );

        allow update: if isConversationMember()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reaction'])
          && (
            request.resource.data.reaction == null
            || (request.resource.data.reaction is string
              && request.resource.data.reaction.size() <= 16)
          );

        allow delete: if isConversationMember()
          && resource.data.senderId == request.auth.uid;
      }
    }
  }
}
