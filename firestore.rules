rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function channelPath(channelId) {
      return /databases/$(database)/documents/channels/$(channelId);
    }

    function channelExists(channelId) {
      return exists(channelPath(channelId));
    }

    function channelData(channelId) {
      return get(channelPath(channelId)).data;
    }

    function isMember(channelId) {
      return signedIn()
        && channelExists(channelId)
        && request.auth.uid in channelData(channelId).members;
    }

    function publicProfilePath(userId) {
      return /databases/$(database)/documents/publicProfiles/$(userId);
    }

    function postPath(postId) {
      return /databases/$(database)/documents/posts/$(postId);
    }

    function postLikePath(postId) {
      return /databases/$(database)/documents/posts/$(postId)/likes/$(request.auth.uid);
    }

    function userLikePath(postId) {
      return /databases/$(database)/documents/users/$(request.auth.uid)/likedPosts/$(postId);
    }

    function commentPath(postId, commentId) {
      return /databases/$(database)/documents/posts/$(postId)/comments/$(commentId);
    }

    function validLikeCountChange(postId) {
      let likeBefore = exists(postLikePath(postId));
      let likeAfter = existsAfter(postLikePath(postId));
      let userLikeBefore = exists(userLikePath(postId));
      let userLikeAfter = existsAfter(userLikePath(postId));
      return likeBefore == userLikeBefore
        && likeAfter == userLikeAfter
        && (
          (!likeBefore && likeAfter
            && request.resource.data.likesCount == resource.data.likesCount + 1)
          ||
          (likeBefore && !likeAfter
            && request.resource.data.likesCount == resource.data.likesCount - 1
            && request.resource.data.likesCount >= 0)
        );
    }

    function validCommentCountIncrement(postId) {
      let newCommentId = request.resource.data.lastCommentId;
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['commentsCount', 'lastCommentId'])
        && request.resource.data.commentsCount == resource.data.commentsCount + 1
        && newCommentId is string
        && newCommentId.size() > 0
        && newCommentId != resource.data.lastCommentId
        && !exists(commentPath(postId, newCommentId))
        && existsAfter(commentPath(postId, newCommentId))
        && getAfter(commentPath(postId, newCommentId)).data.authorId == request.auth.uid;
    }

    match /users/{userId} {
      allow read, create, update, delete: if signedIn() && request.auth.uid == userId;

      match /likedPosts/{postId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create: if signedIn()
          && request.auth.uid == userId
          && request.resource.data.uid == userId
          && request.resource.data.postId == postId
          && request.resource.data.createdAt is int
          && exists(postPath(postId));
        allow delete: if signedIn() && request.auth.uid == userId;
        allow update: if false;
      }

      match /bookmarks/{postId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create: if signedIn()
          && request.auth.uid == userId
          && request.resource.data.postId == postId
          && request.resource.data.createdAt is int
          && exists(postPath(postId));
        allow delete: if signedIn() && request.auth.uid == userId;
        allow update: if false;
      }
    }

    match /publicProfiles/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 1
        && request.resource.data.displayName.size() <= 60
        && request.resource.data.avatarColor is int;
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /channels/{channelId} {
      // Permit probing a deterministic channel ID before creating it. Existing channels
      // can only be read by an authenticated member or if they are public.
      allow get: if signedIn() && (
        !exists(channelPath(channelId))
        || resource.data.isPublic == true
        || request.auth.uid in resource.data.members
      );
      allow list: if signedIn()
        && (resource.data.isPublic == true || request.auth.uid in resource.data.members);

      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.members is list
        && request.auth.uid in request.resource.data.members
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 60
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 300
        && request.resource.data.iconName is string
        && request.resource.data.iconName.size() <= 40
        && request.resource.data.createdAt is int
        && (
          (request.resource.data.kind == 'channel'
            && request.resource.data.isPublic == true
            && request.resource.data.members.size() == 1)
          ||
          (request.resource.data.kind == 'dm'
            && request.resource.data.isPublic == false
            && request.resource.data.members.size() == 2
            && request.resource.data.members[0] is string
            && request.resource.data.members[1] is string
            && request.resource.data.members[0] != request.resource.data.members[1]
            && exists(publicProfilePath(request.resource.data.members[0]))
            && exists(publicProfilePath(request.resource.data.members[1])))
        );

      allow update: if signedIn() && (
        (
          request.auth.uid in resource.data.members
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['lastMessage', 'lastMessageTime'])
          && request.resource.data.lastMessage is string
          && request.resource.data.lastMessage.size() <= 4000
          && request.resource.data.lastMessageTime is int
        )
        ||
        (
          resource.data.isPublic == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && request.auth.uid in request.resource.data.members
          && !(request.auth.uid in resource.data.members)
          && request.resource.data.members.hasAll(resource.data.members)
          && request.resource.data.members.size() == resource.data.members.size() + 1
        )
      );

      allow delete: if signedIn() && resource.data.createdBy == request.auth.uid;

      match /messages/{messageId} {
        allow read: if isMember(channelId)
          || (signedIn() && channelExists(channelId) && channelData(channelId).isPublic == true);

        allow create: if isMember(channelId)
          && request.resource.data.keys().hasOnly([
            'senderId', 'senderName', 'senderAvatarColor', 'content',
            'timestamp', 'status', 'replyToId', 'replyToSnippet', 'reaction'
          ])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.senderName is string
          && request.resource.data.senderName.size() >= 1
          && request.resource.data.senderName.size() <= 60
          && request.resource.data.senderAvatarColor is int
          && request.resource.data.content is string
          && request.resource.data.content.size() >= 1
          && request.resource.data.content.size() <= 4000
          && request.resource.data.timestamp is int
          && request.resource.data.status == 'sent'
          && (request.resource.data.replyToId == null
            || (request.resource.data.replyToId is string && request.resource.data.replyToId.size() <= 128))
          && (request.resource.data.replyToSnippet == null
            || (request.resource.data.replyToSnippet is string && request.resource.data.replyToSnippet.size() <= 120))
          && (request.resource.data.reaction == null
            || (request.resource.data.reaction is string && request.resource.data.reaction.size() <= 16));

        allow update: if isMember(channelId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reaction'])
          && (request.resource.data.reaction == null
            || (request.resource.data.reaction is string && request.resource.data.reaction.size() <= 16));

        allow delete: if isMember(channelId) && resource.data.senderId == request.auth.uid;
      }
    }

    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() >= 1
        && request.resource.data.authorName.size() <= 60
        && request.resource.data.content is string
        && request.resource.data.content.size() >= 1
        && request.resource.data.content.size() <= 4000
        && request.resource.data.tags is string
        && request.resource.data.tags.size() <= 300
        && request.resource.data.category in ['tech', 'design', 'ai']
        && request.resource.data.likesCount == 0
        && request.resource.data.commentsCount == 0
        && request.resource.data.sharesCount == 0
        && request.resource.data.lastCommentId == ''
        && request.resource.data.timestamp is int
        && request.resource.data.authorAvatarColor is int
        && request.resource.data.cardColor is int;

      allow update: if signedIn() && (
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount'])
          && validLikeCountChange(postId)
        )
        || validCommentCountIncrement(postId)
      );
      allow delete: if signedIn() && resource.data.authorId == request.auth.uid;

      match /likes/{uid} {
        allow read: if signedIn() && (
          request.auth.uid == uid
          || (exists(postPath(postId)) && get(postPath(postId)).data.authorId == request.auth.uid)
        );
        allow create: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.uid == uid
          && request.resource.data.postId == postId
          && request.resource.data.createdAt is int
          && exists(postPath(postId));
        allow delete: if signedIn() && (
          request.auth.uid == uid
          || (exists(postPath(postId)) && get(postPath(postId)).data.authorId == request.auth.uid)
        );
        allow update: if false;
      }

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && exists(postPath(postId))
          && request.resource.data.postId == postId
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.authorName is string
          && request.resource.data.authorName.size() >= 1
          && request.resource.data.authorName.size() <= 60
          && request.resource.data.content is string
          && request.resource.data.content.size() >= 1
          && request.resource.data.content.size() <= 2000
          && request.resource.data.timestamp is int;
        allow update: if false;
        allow delete: if signedIn() && (
          resource.data.authorId == request.auth.uid
          || (exists(postPath(postId)) && get(postPath(postId)).data.authorId == request.auth.uid)
        );
      }
    }

    match /stories/{storyId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() >= 1
        && request.resource.data.authorName.size() <= 60
        && request.resource.data.storyTitle is string
        && request.resource.data.storyTitle.size() >= 1
        && request.resource.data.storyTitle.size() <= 500
        && request.resource.data.authorAvatarColor is int
        && request.resource.data.timestamp is int;
      allow update: if false;
      allow delete: if signedIn() && resource.data.authorId == request.auth.uid;
    }
  }
}
